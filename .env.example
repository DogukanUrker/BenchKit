# auto, openai, or ollama
BENCHKIT_PROVIDER=auto

# host url
BENCHKIT_HOST=http://localhost:11434/v1

# Optional for authenticated OpenAI-compatible servers
# BENCHKIT_API_KEY=

# Used in the HTML report's social card
BENCHKIT_HARDWARE=RTX 3060 12GB

# Optional reproducibility note for performance profiles
# BENCHKIT_PERF_CONFIG=RTX 3060 12GB | q8_0 KV | -np 1

# Hard per-task generation deadline in seconds
BENCHKIT_TIMEOUT=300

# Kill after a confirmed active suffix cycle stays at/above 80% for 10 seconds
# Set BENCHKIT_LOOP_KILL=false to detect loops without killing the generation
BENCHKIT_LOOP_KILL=true
BENCHKIT_LOOP_KILL_PERCENT=80
BENCHKIT_LOOP_KILL_SECONDS=10
