# auto, openai, or ollama
BENCHKIT_PROVIDER=auto

# host url
BENCHKIT_HOST=http://localhost:11434/v1

# Optional for authenticated OpenAI-compatible servers
# BENCHKIT_API_KEY=

# Used in the HTML report's social card
BENCHKIT_HARDWARE=RTX 3060 12GB

# Optional reproducibility note for performance profiles
# BENCHKIT_PERF_CONFIG=RTX 3060 12GB | q8_0 KV | -np 1

# Hard per-task generation deadline in seconds
BENCHKIT_TIMEOUT=300

# Stock Pi harness (requires Docker). The Pi package version is pinned in BenchKit.
# BENCHKIT_PI_TIMEOUT=900
# BENCHKIT_SANDBOX_MEMORY=2g
# BENCHKIT_SANDBOX_CPUS=2
# BENCHKIT_SANDBOX_PIDS=256
# BENCHKIT_DOCKER=docker

# Retries for transient API failures (502/503/504, 429, connection resets)
# with exponential backoff between attempts, in seconds
BENCHKIT_RETRIES=3
# DNS/connect failures get a longer retry window (total attempts)
BENCHKIT_CONNECT_RETRIES=6
BENCHKIT_RETRY_BASE_DELAY=0.5
BENCHKIT_RETRY_MAX_DELAY=8

# Ceiling for a server-supplied Retry-After wait (429 rate limits), in seconds
BENCHKIT_RETRY_MAX_WAIT=60

# Kill after a confirmed active suffix cycle stays at/above 80% for 10 seconds
# Set BENCHKIT_LOOP_KILL=false to detect loops without killing the generation
BENCHKIT_LOOP_KILL=true
BENCHKIT_LOOP_KILL_PERCENT=80
BENCHKIT_LOOP_KILL_SECONDS=10

# mc-arena runs each generated build script in a throwaway Docker container
# with no network, and renders the result with the bundled prismarine-viewer.
# BENCHKIT_MC_ARENA_MEMORY=512m
# BENCHKIT_MC_ARENA_CPUS=1
# BENCHKIT_MC_ARENA_PIDS=64
# Python base image for the script runner, for hosts behind a registry mirror
# BENCHKIT_MC_ARENA_BASE_IMAGE=python:3.12-slim
# Skip the image build entirely and use one you built yourself; it needs uv on
# PATH and a writable /work
# BENCHKIT_MC_ARENA_IMAGE=

# treejs-arena headless rendering, and mc-arena screenshots (requires the
# browser extra and Chromium)
# Seconds to let the scene settle before the screenshot
# BENCHKIT_RENDER_SETTLE=4
# Hard deadline for navigation and capture, in seconds
# BENCHKIT_RENDER_TIMEOUT=30
# Hosts the untrusted generated page may reach; everything else is aborted
# BENCHKIT_RENDER_ALLOWED_HOSTS=cdn.jsdelivr.net,cdnjs.cloudflare.com,esm.sh,threejs.org,unpkg.com
# Block every request instead, including module CDNs
# BENCHKIT_RENDER_OFFLINE=false
# Use an existing Chromium build instead of Playwright's own download
# BENCHKIT_RENDER_CHROMIUM=/opt/chromium/chrome
# Drop the Chromium sandbox (needed in some containers; weakens isolation)
# BENCHKIT_RENDER_NO_SANDBOX=false
